        992,
        -16
      ],
      "notesInFlow": true,
      "notes": "Edit all settings here"
    },
    {
      "parameters": {
        "jsCode": "// Mode: Run Once for All Items\nconst e = $input.first().json;\nconst workflowName = e.workflow?.name ?? '-';\nconst text = [\n  ':rotating_light: *Workflow-Fehler*',\n  `*Workflow:* ${workflowName}`,\n  `*Node:* ${e.execution?.lastNodeExecuted ?? e.trigger?.error?.node?.name ?? '-'}`,\n  `*Fehler:* ${e.execution?.error?.message ?? e.trigger?.error?.message ?? 'unbekannt'}`,\n  e.execution?.error?.description ? `*Details:* ${e.execution.error.description}` : null,\n  e.execution?.url ? `*Execution:* ${e.execution.url}` : null,\n  /RFQ/i.test(workflowName) ? 'Die betroffene E-Mail bleibt ungelesen und muss manuell bearbeitet werden.' : null,\n].filter(Boolean).join('\\n');\nreturn [{ json: { slackText: text } }];\n"
      },
      "id": "815ea57a-66d6-497b-a435-a206548d20c3",
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1216,
        -16
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.cfg.slackWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.slackText }) }}",
        "options": {
          "timeout": 30000
        }
      },
